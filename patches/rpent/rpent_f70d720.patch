+                        f"this run's output directory are ({target})"
+                    }
+                return handler(str(target), **kwargs)
+
+            return guarded
+
+        for name in knowledge_eval.GUARDED_READ_TOOLS:
+            spec, handler = self._tools[name]
+            self.add_tool(name, spec, confined(handler))
+
